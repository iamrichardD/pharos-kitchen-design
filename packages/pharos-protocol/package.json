{
  "name": "@pkd/protocol",
  "version": "0.1.0",
  "description": "Shared protocols and types for Pharos Kitchen Design",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.mjs",
  "files": [
