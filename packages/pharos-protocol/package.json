  },
  "keywords": [
    "pharos",
    "aec",
    "bim"
  ],
  "author": "Richard D. (https://github.com/iamrichardd)",
  "license": "FSL-1.1",
  "dependencies": {
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
