# Stage 1: Rust Builder (Metadata Core)
FROM public.ecr.aws/docker/library/rust@sha256:fb328f0f58becb23ba1719940a2c94ece8b0b48afa837d05b79ef64bc1e18f6e AS rust-builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js v24 (LTS) for workspace management
RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get install -y nodejs \
    && npm install -g npm@latest

# Install cargo-audit for Rust vulnerability scanning
RUN cargo install cargo-audit && cargo install wasm-pack --version 0.15.0

WORKDIR /work
COPY . .

# Ensure workspaces are recognized even if empty
RUN mkdir -p apps packages

# Default command: Audit then Test
CMD ["sh", "-c", "npm run audit && npm test"]
