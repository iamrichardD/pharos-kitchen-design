# ========================================================================
# Project: Pharos Kitchen Design (Project Prism)
# Component: DevSecOps / CI
# File: Containerfile.pulse
# Author: Richard D. (https://github.com/iamrichardd)
# License: FSL-1.1
# Purpose: Unified "Pulse" validation for Rust, .NET, and TypeScript.
# Why: ADR-0017 (Multi-Stage chaining) ensures cross-language FFI stability.
# Traceability: Issue #105 (CI/CD Optimization & Hardening)
# ========================================================================

# Stage 1: Rust Chef (Common layer for caching)
FROM public.ecr.aws/docker/library/rust@sha256:70aebe351faa35667ef36508deb19fe234ff03d67cfe102f095d920a53d0622c AS chef
RUN apt-get update && apt-get install -y pkg-config libssl-dev curl && \
    curl https://rustwasm.github.io/wasm-pack/installer/init.sh -sSf | sh && \
    rm -rf /var/lib/apt/lists/*
RUN cargo install cargo-chef
WORKDIR /work

# Stage 2: Planner (Generate dependency recipe)
FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

# Stage 3: Cacher (Build dependency graph)
FROM chef AS cacher
COPY --from=planner /work/recipe.json recipe.json
RUN cargo chef cook --recipe-path recipe.json

# Stage 4: Rust Builder (Metadata Core, CLI, and WASM Dialects)
FROM chef AS rust-builder
ARG BUILD_MODE=debug
ENV BUILD_MODE=$BUILD_MODE
# Enable full backtraces for debug builds to facilitate rapid root-cause analysis.
ENV RUST_BACKTRACE=full
WORKDIR /work
# Install cargo-audit (Download binary to avoid source compilation bloat)
RUN curl -LsSf https://github.com/rustsec/rustsec/releases/download/cargo-audit%2Fv0.22.1/cargo-audit-x86_64-unknown-linux-musl-v0.22.1.tgz | tar xzf - -C /usr/local/cargo/bin --strip-components 1

# Copy pre-built dependencies from cacher
COPY --from=cacher /work/target target
COPY --from=cacher /usr/local/cargo /usr/local/cargo

# Copy source code (Full workspace for atomic validation)
COPY . .

# Run Rust unit tests, compile core, and perform security audit.
RUN cd packages/pkd-core && cargo test && \
    if [ "$BUILD_MODE" = "release" ]; then cargo build --release; else cargo build; fi && \
    cargo audit
# AUTHORITATIVE GATE: Verify and build pkd-cli
RUN cd packages/pkd-cli && cargo test && \
    if [ "$BUILD_MODE" = "release" ]; then cargo build --release; else cargo build; fi
# Build and stage WASM dialects for the TS auditor
RUN bash scripts/build-wasm.sh

# Stage 5: Node.js (TypeScript & Security Audit)
FROM mcr.microsoft.com/playwright@sha256:b0ab6f3cb99aa7803adbc14d9027ec1785fc6e433b97e134e0f8fe61683b6b53 AS ts-auditor
ARG BUILD_MODE=debug
# Force Node 24 installation on top of Playwright image
RUN apt-get update && apt-get install -y curl && \
    curl -fsSL https://deb.nodesource.com/setup_24.x | bash - && \
    apt-get install -y nodejs python3 make g++ libssl-dev pkg-config && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /work
COPY . .

# DETERMINISTIC STAGING (Option A):
# Copy pre-compiled WASM dialects and core bindings from the Rust builder stage.
COPY --from=rust-builder /work/dist/dialects /work/dist/dialects
COPY --from=rust-builder /work/packages/pkd-core/pkg /work/packages/pkd-core/pkg
# Copy pkd-cli for manifest verification (Issue #110)
COPY --from=rust-builder /work/target/$BUILD_MODE/pkd /usr/local/bin/pkd
RUN chmod +x /usr/local/bin/pkd

# MANDATORY CI GATE: Verify WASM manifest integrity before testing (ADR-0029)
RUN pkd core verify-manifest /work/dist/dialects

# Perform dependency audit and TS unit tests.
RUN npm install && \
    npm rebuild better-sqlite3 && \
    (npm audit --workspaces || echo "⚠️ Warning: Audit found known issues, proceeding per SECURITY_LOG.md") && \
    npm test

# Stage 6: .NET SDK (Integrated \"Pulse\" Handshake)
FROM mcr.microsoft.com/dotnet/sdk@sha256:3e7b0cefe1b00a350ffb0e06b4e1271a4e791df6b8ac4239be05f1ae2736fcff AS pulse-final
ARG BUILD_MODE=debug
ENV BUILD_MODE=$BUILD_MODE
WORKDIR /work
COPY . .

# INSTALL RUNTIME DEPENDENCIES (Required for pkd-cli)
RUN apt-get update && apt-get install -y libssl-dev pkg-config && rm -rf /var/lib/apt/lists/*

# COPY THE HANDSHAKE ARTIFACTS:
COPY --from=rust-builder /work/target/$BUILD_MODE/libpkd_core.so /work/target/$BUILD_MODE/libpkd_core.so
COPY --from=rust-builder /work/target/$BUILD_MODE/pkd /usr/local/bin/pkd
RUN chmod +x /usr/local/bin/pkd

# Ensure the ts-auditor stage also completed successfully.
COPY --from=ts-auditor /work/package.json /work/ts-auditor-marker

# Default entrypoint: Run the Revit Bridge integration tests.
# Why: Pass the configuration to dotnet test to match the Rust build mode.
CMD ["sh", "-c", "if [ \"$BUILD_MODE\" = \"release\" ]; then CONF=\"Release\"; else CONF=\"Debug\"; fi && dotnet test -c $CONF packages/revit-bridge/tests/Pkd.RevitBridge.Tests/Pkd.RevitBridge.Tests.csproj"]
