---
/**
 * Project: Pharos Kitchen Design (Project Prism)
 * Component: Layouts / Base
 * License: FSL-1.1 (See LICENSE file for details)
 * File: BaseLayout.astro
 * Author: Richard D. (https://github.com/iamrichardd)
 * Purpose: Global shell for the IKD marketing site.
 * Traceability: ADR 0012, ADR 0013, ADR 0015, Issue #81, Issue #312
 * Deployment-Trigger: Issue #76 / Issue #78 Recovery Run
 * Last Updated: 2026-06-30
 */

import '../styles/global.css';
import { navItems } from '../config/navigation';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Pharos Kitchen Design (PKD): Metadata-First Truth for the Independent Kitchen Designer." } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />

		<!-- Favicons -- full set generated from the Pharos Systems brand mark (Nano Banana 2).
		     The previous <link rel="icon" href="/favicon.svg"> pointed at a file that never existed. -->
		<link rel="icon" href="/pharos-kitchen-design/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="16x16" href="/pharos-kitchen-design/favicon-16x16.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/pharos-kitchen-design/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="48x48" href="/pharos-kitchen-design/favicon-48x48.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/pharos-kitchen-design/apple-touch-icon.png" />
		<link rel="apple-touch-icon" sizes="152x152" href="/pharos-kitchen-design/apple-touch-icon-152x152.png" />
		<link rel="apple-touch-icon" sizes="167x167" href="/pharos-kitchen-design/apple-touch-icon-167x167.png" />
		<link rel="manifest" href="/pharos-kitchen-design/site.webmanifest" />
		<meta name="theme-color" content="#0284c7" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Pharos Kitchen Design</title>
		<meta name="description" content={description} />

		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Roboto+Condensed:wght@700&display=swap" rel="stylesheet">

		<!-- Umami Analytics (Hardened with SRI) -->
		<script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="72cdde11-d1e4-4a33-9cc3-a00d5fe4651b" integrity="sha384-DCWdwYp9BA8848i6w0Y5RQh8ANWh1jp1+NjJ/a+jqFZi1nvw6st1t+bFQ9+hhNXe" crossorigin="anonymous"></script>
	</head>
	<body class="blueprint-grid min-h-screen flex flex-col">
		<header class="border-b border-border-blueprint py-4 bg-bg-base/80 backdrop-blur-sm sticky top-0 z-50 transition-colors duration-300">
			<div class="container mx-auto px-4 flex justify-between items-center">
				<a href="/pharos-kitchen-design/" class="flex items-center gap-2">
					<div class="w-8 h-8 bg-ph-orange flex items-center justify-center font-condensed text-ph-charcoal text-xl">P</div>
					<span class="font-condensed text-xl tracking-tight hidden sm:inline">PHAROS KITCHEN DESIGN</span>
				</a>
				<nav class="hidden md:flex gap-6 font-condensed text-sm tracking-widest uppercase items-center">
					{navItems.map((item) => {
						const isActive = currentPath === item.path || currentPath === `${item.path}/`;
						return (
							<a
								href={item.path}
								class={isActive ? "text-ph-orange underline underline-offset-4 decoration-ph-orange/50 pointer-events-none" : "hover:text-ph-orange transition-colors"}
							>
								{item.label}
							</a>
						);
					})}
					<pharos-nav-auth
						active-class="text-ph-orange underline underline-offset-4 decoration-ph-orange/50 pointer-events-none"
						inactive-class="hover:text-ph-orange transition-colors"
					>
						<a
							href="/pharos-kitchen-design/login"
							class={(currentPath === '/pharos-kitchen-design/login' || currentPath === '/pharos-kitchen-design/login/') ? "text-ph-orange underline underline-offset-4 decoration-ph-orange/50 pointer-events-none" : "hover:text-ph-orange transition-colors"}
						>
							Login
						</a>
					</pharos-nav-auth>
				</nav>
				<button 
					id="menu-btn" 
					class="md:hidden flex flex-col justify-center items-center w-8 h-8 gap-1.5 focus:outline-none cursor-pointer" 
					aria-expanded="false" 
					aria-controls="mobile-menu" 
					aria-label="Toggle Menu"
				>
					<span class="w-6 h-0.5 bg-text-base transition-transform duration-300"></span>
					<span class="w-6 h-0.5 bg-text-base transition-transform duration-300"></span>
					<span class="w-6 h-0.5 bg-text-base transition-transform duration-300"></span>
				</button>
			</div>
			<div 
				id="mobile-menu" 
				class="hidden absolute top-[65px] left-0 w-full bg-bg-base/95 backdrop-blur-md border-b border-border-blueprint/50 flex-col items-end p-6 gap-4 font-condensed text-sm tracking-widest uppercase md:hidden z-40"
			>
				{navItems.map((item) => {
					const isActive = currentPath === item.path || currentPath === `${item.path}/`;
					return (
						<a
							href={item.path}
							class={isActive ? "w-full text-right text-ph-orange underline underline-offset-4 decoration-ph-orange/50 pointer-events-none" : "w-full text-right hover:text-ph-orange transition-colors"}
							data-astro-prefetch="viewport"
						>
							{item.label}
						</a>
					);
				})}
				<pharos-nav-auth
					active-class="w-full text-right text-ph-orange underline underline-offset-4 decoration-ph-orange/50 pointer-events-none pt-2 border-t border-border-blueprint/10"
					inactive-class="w-full text-right hover:text-ph-orange transition-colors pt-2 border-t border-border-blueprint/10"
				>
					<a
						href="/pharos-kitchen-design/login"
						class={(currentPath === '/pharos-kitchen-design/login' || currentPath === '/pharos-kitchen-design/login/') ? "w-full text-right text-ph-orange underline underline-offset-4 decoration-ph-orange/50 pointer-events-none pt-2 border-t border-border-blueprint/10" : "w-full text-right hover:text-ph-orange transition-colors pt-2 border-t border-border-blueprint/10"}
						data-astro-prefetch="viewport"
					>
						Login
					</a>
				</pharos-nav-auth>
			</div>
		</header>

		<main class="flex-grow">
			<slot />
		</main>

		<footer class="border-t border-border-blueprint py-8 bg-bg-base/50 transition-colors duration-300">
			<div class="container mx-auto px-4 flex flex-col md:flex-row justify-between items-center gap-4">
				<div class="text-xs text-text-muted font-mono uppercase tracking-widest">
					PROJECT: PKD // STATUS: DETERMINISTIC // [FSL-1.1]
				</div>
				<div class="flex gap-6 items-center">
					<a href="https://iamrichardd.com" class="text-xs text-text-muted hover:text-ph-orange transition-colors">A Project by Richard D.</a>
					<a href="https://github.com/iamrichardD/pharos-kitchen-design" class="text-xs text-ph-blue hover:text-ph-orange transition-colors uppercase font-bold tracking-widest">GitHub Repository</a>
				</div>
			</div>
		</footer>

		<script>
			import '../components/pharos-nav-auth';
		</script>

		<script is:inline>
			const menuBtn = document.getElementById('menu-btn');
			const mobileMenu = document.getElementById('mobile-menu');
			
			if (menuBtn && mobileMenu) {
				menuBtn.addEventListener('click', () => {
					const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
					menuBtn.setAttribute('aria-expanded', !isExpanded ? 'true' : 'false');
					mobileMenu.classList.toggle('hidden');
					mobileMenu.classList.toggle('flex');
					
					// Animate hamburger button spans into an X
					const spans = menuBtn.querySelectorAll('span');
					if (spans.length === 3) {
						if (!isExpanded) {
							spans[0].style.transform = 'translateY(8px) rotate(45deg)';
							spans[1].style.opacity = '0';
							spans[2].style.transform = 'translateY(-8px) rotate(-45deg)';
						} else {
							spans[0].style.transform = 'none';
							spans[1].style.opacity = '1';
							spans[2].style.transform = 'none';
						}
					}
				});
			}
		</script>
	</body>
</html>
