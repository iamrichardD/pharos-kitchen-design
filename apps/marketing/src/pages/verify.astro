import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Device Verification | Pharos Kitchen Design Identity Bridge">
  <main class="max-w-4xl mx-auto px-6 py-20 min-h-screen flex flex-col items-center justify-center blueprint-grid transition-colors duration-300">
    <div class="w-full max-w-md bg-bg-base/40 border border-border-blueprint/20 p-10 relative overflow-hidden blueprint-border">
      
      <!-- Grid Decoration -->
      <div class="absolute inset-0 opacity-5 pointer-events-none blueprint-grid"></div>

      <div class="relative z-10 text-center">
        <h1 class="text-4xl font-bold mb-4 font-mono tracking-tighter italic uppercase text-text-base">
          VERIFY_DEVICE
        </h1>
        <p class="text-text-muted mb-6 text-sm leading-relaxed font-mono">
          Enter the code displayed on your device and authenticate to link your identity.
        </p>

        <p id="hardware-hint" class="hidden mb-6 text-xs text-ph-blue font-mono bg-ph-blue/5 p-4 border-l-2 border-ph-blue text-left leading-relaxed">
          Looking for a security key. If you don't have one plugged in, you can scan the QR code with your phone's camera to sign in.
        </p>

        <!-- Kathy Sierra UX Hook: Empowering Context -->
        <div id="ux-hook-container" class="hidden mb-6 text-left border-l-2 border-ph-blue pl-4 py-2 bg-ph-blue/5">
            <h3 id="ux-hook-title" class="text-ph-blue font-bold text-sm tracking-widest uppercase mb-1">Secure Identity</h3>
            <p id="ux-hook-text" class="text-text-muted text-xs font-mono leading-relaxed"></p>
        </div>

        <form id="verify-form" class="space-y-6">
          <div class="space-y-2 text-left">
            <label for="user_code" class="block text-[10px] font-mono text-ph-blue uppercase tracking-widest">
              [USER_CODE] (Optional for web-only login)
            </label>
            <input 
              type="text" 
              id="user_code" 
              name="user_code" 
              placeholder="ABCD-1234 (Optional)"
              class="w-full bg-bg-base/60 border border-border-blueprint/40 px-4 py-4 text-center text-3xl font-mono text-ph-orange placeholder:text-text-muted focus:outline-none focus:border-ph-orange transition-colors"
              maxlength="9"
            />
          </div>

          <div class="space-y-2 text-left">
            <label for="username" class="block text-[10px] font-mono text-ph-blue uppercase tracking-widest">[AUTHORITY_HANDLE]</label>
            <input type="text" id="username" name="username" placeholder="designer@studio.com" required class="w-full bg-bg-base/60 border border-border-blueprint/20 px-3 py-2 font-mono text-text-base text-sm focus:outline-none focus:border-ph-orange" />
          </div>

          <div class="flex items-center gap-2 py-2 text-left">
            <input 
              type="checkbox" 
              id="register_toggle" 
              name="register_toggle" 
              class="w-4 h-4 bg-bg-base/60 border border-border-blueprint/40 checked:bg-ph-orange focus:ring-0 focus:outline-none accent-ph-orange cursor-pointer"
            />
            <label for="register_toggle" class="text-[10px] font-mono text-text-muted uppercase tracking-widest cursor-pointer select-none">
              Register new device/account
            </label>
          </div>

          <div id="status-container" class="hidden text-xs font-mono py-2 px-4 border-l-2 border-ph-orange bg-ph-orange/10 text-ph-orange text-left mb-6">
            <!-- Dynamic Status -->
          </div>

          <button 
            type="submit" 
            id="submit-btn"
            class="w-full bg-ph-blue text-ph-charcoal font-bold py-4 hover:bg-white transition-colors uppercase tracking-widest text-sm"
          >
            LOGIN
          </button>
        </form>

        <div id="success-container" class="hidden space-y-6">
            <div class="text-ph-pulse text-6xl mb-4">✓</div>
            <h2 class="text-2xl font-bold text-text-base uppercase tracking-tighter">Device Authorized</h2>
            <p class="text-text-muted text-sm leading-relaxed font-mono">
              The cryptographic hardware handshake is complete. You can now return to your Revit workstation.
            </p>
            <a href="/pharos-kitchen-design/roadmap" class="inline-block mt-8 text-ph-blue hover:text-white transition-colors font-mono text-xs uppercase tracking-widest">
                Return to Matrix >>
            </a>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  import { startAuthentication, startRegistration } from '@simplewebauthn/browser';
  import { SessionManager } from '../utils/session';

  const AUTH_URL = 'http://localhost:8787'; // Dev fallback, should be environment driven

  const form = document.getElementById('verify-form') as HTMLFormElement;
  const statusContainer = document.getElementById('status-container');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const successContainer = document.getElementById('success-container');
  
  const uxHookContainer = document.getElementById('ux-hook-container');
  const uxHookTitle = document.getElementById('ux-hook-title');
  const uxHookText = document.getElementById('ux-hook-text');

  const showStatus = (msg: string, isError = false) => {
    if (!statusContainer) return;
    statusContainer.innerText = `>> ${msg}`;
    statusContainer.classList.remove('hidden');
    statusContainer.style.borderColor = isError ? '#ef4444' : '#f97316';
    statusContainer.style.color = isError ? '#ef4444' : '#f97316';
  };

  const showUXHook = (title: string, text: string) => {
      if (uxHookContainer && uxHookTitle && uxHookText) {
          uxHookTitle.innerText = title;
          uxHookText.innerText = text;
          uxHookContainer.classList.remove('hidden');
      }
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const hardwareHint = document.getElementById('hardware-hint');
    if (hardwareHint) hardwareHint.classList.remove('hidden');
    const formData = new FormData(form);
    const user_code = formData.get('user_code') as string;
    const username = formData.get('username') as string;
    const isRegisterMode = (document.getElementById('register_toggle') as HTMLInputElement)?.checked;

    submitBtn.disabled = true;
    submitBtn.innerText = isRegisterMode ? "CONTINUING..." : "LOGGING IN...";
    showStatus("Locating identity shards...");

    try {
        // 1. Fetch Auth Options
        let isRegistration = isRegisterMode;
        let optionsRes;

        if (isRegistration) {
            showStatus("Initializing registration challenge...");
            optionsRes = await fetch(`${AUTH_URL}/auth/register/options`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ username })
            });
        } else {
            showStatus("Requesting authentication options...");
            optionsRes = await fetch(`${AUTH_URL}/auth/login/options`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ username })
            });
        }

        let resData = await optionsRes.json() as any;

        if (!optionsRes.ok) {
            if (resData.error === 'user_not_found' && !isRegistration) {
                throw new Error("Account not found. Please verify your handle or check 'Register new device/account' to sign up.");
            } else {
                throw new Error(resData.error || "Failed to initialize security challenge.");
            }
        }

        const { options, challengeToken, pkd_metadata } = resData;
        
        // Kathy Sierra UX Hook: Show empowering message before hardware prompt
        if (pkd_metadata) {
            showUXHook(pkd_metadata.title, pkd_metadata.hook);
        }

        showStatus(isRegistration ? "Awaiting hardware registration..." : "Awaiting hardware confirmation...");

        // 2. Browser Passkey Prompt
        let asseResp;
        try {
            if (isRegistration) {
                asseResp = await startRegistration({ optionsJSON: options });
            } else {
                asseResp = await startAuthentication({ optionsJSON: options });
            }
        } catch (error: any) {
            throw new Error(`Hardware ${isRegistration ? 'registration' : 'verification'} cancelled or failed: ${error.message}`);
        }

        showStatus("Verifying cryptographic proof...");

        // 3. Verify Authentication/Registration
        const verifyEndpoint = isRegistration ? `${AUTH_URL}/auth/register/verify` : `${AUTH_URL}/auth/login/verify`;
        const verifyRes = await fetch(verifyEndpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                response: asseResp,
                challengeToken
            })
        });

        if (!verifyRes.ok) {
            throw new Error(`Failed to verify hardware identity.`);
        }

        const { access_token } = await verifyRes.json() as any;

        const trimmedCode = user_code ? user_code.trim() : "";
        if (trimmedCode) {
            showStatus("Linking Edge Bridge...");
            
            // 4. Call the Auth Bridge (Worker) to approve the device code
            const confirmRes = await fetch(`${AUTH_URL}/auth/confirm`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    user_code: trimmedCode.replace('-', '').toUpperCase(),
                    access_token
                })
            });

            if (!confirmRes.ok) {
                const err = await confirmRes.json() as any;
                throw new Error(err.error || "Bridge handshake failed");
            }
        }

        if (access_token) {
            SessionManager.setSession(access_token);
        }

        if (!trimmedCode) {
            const successText = successContainer?.querySelector('p');
            const successTitle = successContainer?.querySelector('h2');
            if (successTitle) successTitle.textContent = "Authenticated";
            if (successText) successText.textContent = "You are now logged in. Your session is active.";
        }

        form.classList.add('hidden');
        uxHookContainer?.classList.add('hidden');
        successContainer?.classList.remove('hidden');

    } catch (err: any) {
        showStatus(err.message, true);
        submitBtn.disabled = false;
        submitBtn.innerText = isRegisterMode ? "CONTINUE" : "LOGIN";
    }
  });

  // Auto-format user_code (ABCD-1234)
  const input = document.getElementById('user_code') as HTMLInputElement;
  input?.addEventListener('input', () => {
    let value = input.value.replace(/[^a-zA-Z0-9]/g, '').toUpperCase();
    if (value.length > 4) {
      value = value.slice(0, 4) + '-' + value.slice(4, 8);
    }
    input.value = value;
  });

  // Dynamic Button Text based on Register Checkbox state
  const registerToggle = document.getElementById('register_toggle') as HTMLInputElement;
  registerToggle?.addEventListener('change', () => {
    if (registerToggle.checked) {
      submitBtn.innerText = "CONTINUE";
    } else {
      submitBtn.innerText = "LOGIN";
    }
  });
</script>
