---
/* ========================================================================
 * Project: Pharos Kitchen Design (Project Prism)
 * Component: Marketing Site / Pages / Install
 * File: install.astro
 * Author: Richard D. (https://github.com/iamrichardd)
 * License: FSL-1.1 (See LICENSE file for details)
 * Purpose: High-fidelity CLI installation landing page.
 * Traceability: Issue #76, Issue #81, ADR-0006
 * ======================================================================== */

import BaseLayout from '../layouts/BaseLayout.astro';
import BlueprintCard from '../components/BlueprintCard.astro';
import PlatformTabs from '../components/PlatformTabs.astro';
---

<BaseLayout title="Install pkd CLI" description="Download and install the Pharos Kitchen Design command-line interface.">
  <div class="container mx-auto px-4 py-12">
    <div class="max-w-4xl mx-auto">
      <header class="mb-12">
        <h1 class="text-4xl md:text-5xl mb-4">Command-First Infrastructure</h1>
        <p class="text-xl text-text-muted max-w-2xl font-mono uppercase tracking-tighter">
          Download and Install pkd: The reliable command center for the modern Independent Kitchen Designer.
        </p>
      </header>

      <PlatformTabs>
        <div slot="linux">
          <BlueprintCard title="Linux (x86_64 / AArch64)">
            <div class="space-y-6 font-mono text-sm">
              <div class="flex justify-between items-start">
                <p class="text-text-muted italic border-l-2 border-ph-blue pl-4">Primary Development Target</p>
                <span class="px-2 py-0.5 text-[10px] font-bold tracking-widest bg-ph-blue/20 text-ph-blue border border-ph-blue/50 rounded">TECHNICAL PREVIEW</span>
              </div>
              
              <div>
                <h3 class="text-ph-orange mb-2">1. System Dependencies</h3>
                <p class="mb-2">PKD uses your computer's secure storage to keep your session safe. Ensure the following items are installed:</p>
                <div class="bg-black/20 p-4 border border-ph-blue/30">
                  <code class="text-ph-blue"># Ubuntu / Debian</code><br/>
                  <code>sudo apt-get install libsecret-1-dev gnome-keyring</code><br/><br/>
                  <code class="text-ph-blue"># Fedora</code><br/>
                  <code>sudo dnf install libsecret-devel</code>
                </div>
              </div>

              <div>
                <h3 class="text-ph-orange mb-2">2. Installation</h3>
                <div class="bg-black/20 p-4 border border-ph-blue/30">
                  <code class="text-ph-blue"># Download and install via shell script</code><br/>
                  <code>curl -sSf https://iamrichardd.com/pharos-kitchen-design/install.sh | sh</code>
                </div>
              </div>

              <div>
                <h3 class="text-ph-orange mb-2">3. Verification</h3>
                <div class="bg-black/20 p-4 border border-ph-blue/30">
                  <code>pkd --version</code>
                </div>
              </div>

              <div>
                <h3 class="text-ph-orange mb-2">4. Lifecycle Management</h3>
                <p class="mb-2">Keep your pkd tool reliable by updating regularly:</p>
                <div class="bg-black/20 p-4 border border-ph-blue/30">
                  <code>pkd self-update</code>
                </div>
              </div>
            </div>
          </BlueprintCard>
        </div>

        <div slot="windows">
          <BlueprintCard title="Windows (x64)">
            <div class="space-y-6 font-mono text-sm">
              <div class="flex justify-between items-start">
                <p class="text-text-muted italic border-l-2 border-ph-blue pl-4">Native Credential Management</p>
                <span class="px-2 py-0.5 text-[10px] font-bold tracking-widest bg-ph-blue/20 text-ph-blue border border-ph-blue/50 rounded">TECHNICAL PREVIEW</span>
              </div>

              <div>
                <h3 class="text-ph-orange mb-2">Security Note</h3>
                <p class="mb-4">
                  The `pkd` CLI integrates with **Windows Credential Manager** to store authentication tokens. No additional drivers are required.
                </p>
              </div>

              <div>
                <h3 class="text-ph-orange mb-2">1. Installation</h3>
                <p class="mb-2">Download the installer or use PowerShell:</p>
                <div class="bg-black/20 p-4 border border-ph-blue/30 overflow-x-auto">
                  <code>irm https://iamrichardd.com/pharos-kitchen-design/install.ps1 | iex</code>
                </div>
              </div>

              <div>
                <h3 class="text-ph-orange mb-2">2. Verification</h3>
                <div class="bg-black/20 p-4 border border-ph-blue/30">
                  <code>pkd --version</code>
                </div>
              </div>

              <div>
                <h3 class="text-ph-orange mb-2">3. Lifecycle Management</h3>
                <p class="mb-2">Automated updates via the command center:</p>
                <div class="bg-black/20 p-4 border border-ph-blue/30">
                  <code>pkd self-update</code>
                </div>
              </div>
            </div>
          </BlueprintCard>
        </div>

        <div slot="macos">
          <BlueprintCard title="macOS (Universal Binary)">
            <div class="space-y-6 font-mono text-sm">
              <div class="flex justify-between items-start">
                <p class="text-text-muted italic border-l-2 border-ph-blue pl-4">Manual Audit Trust Path</p>
                <span class="px-2 py-0.5 text-[10px] font-bold tracking-widest bg-ph-blue/20 text-ph-blue border border-ph-blue/50 rounded">TECHNICAL PREVIEW</span>
              </div>

              <div>
                <h3 class="text-ph-orange mb-2">1. Acquire Binary</h3>
                <p class="mb-4">
                  Download the latest **Universal Binary** from the official GitHub repository. 
                </p>
                <div class="bg-black/20 p-4 border border-ph-blue/30">
                  <a href="https://github.com/iamrichardD/pharos-kitchen-design/releases" class="text-ph-blue hover:text-ph-orange underline">GitHub Releases: pkd-macos-universal</a>
                </div>
              </div>

              <div>
                <h3 class="text-ph-orange mb-2">2. Global Accessibility</h3>
                <p class="mb-2">Move the tool to your system path. Note: You may be asked for your computer password to allow the system to securely store the tool:</p>
                <div class="bg-black/20 p-4 border border-ph-blue/30">
                  <code>chmod +x pkd && sudo mv pkd /usr/local/bin/</code>
                </div>
              </div>

              <div>
                <h3 class="text-ph-orange mb-2">3. Security Authorization</h3>
                <p class="mb-2">As an independent FSL-1.1 project, manual authorization is required for the application:</p>
                <div class="bg-black/20 p-4 border border-ph-blue/30">
                  <code>xattr -d com.apple.quarantine /usr/local/bin/pkd</code>
                </div>
              </div>

              <!-- TODO: Implement Homebrew Tap (Issue #81 / future)
              <div>
                <h3 class="text-ph-orange mb-2">2. Installation</h3>
                <p class="mb-2">Install via Homebrew tap:</p>
                <div class="bg-black/20 p-4 border border-ph-blue/30">
                  <code>brew install iamrichardd/pkd/pkd</code>
                </div>
              </div>
              -->

              <div>
                <h3 class="text-ph-orange mb-2">4. Verification</h3>
                <div class="bg-black/20 p-4 border border-ph-blue/30">
                  <code>pkd --version</code>
                </div>
              </div>

              <div>
                <h3 class="text-ph-orange mb-2">5. Lifecycle Management</h3>
                <p class="mb-2">Keep your macOS workstation in sync:</p>
                <div class="bg-black/20 p-4 border border-ph-blue/30">
                  <code>pkd self-update</code>
                </div>
              </div>
            </div>
          </BlueprintCard>
        </div>
      </PlatformTabs>

      <footer class="mt-12 pt-12 border-t border-border-blueprint/30">
        <p class="text-xs text-text-muted uppercase tracking-widest font-mono">
          Security: All binaries are signed. Verify checksums in the <a href="https://github.com/iamrichardD/pharos-kitchen-design/releases" class="text-ph-blue hover:text-ph-orange">GitHub Releases</a>.
        </p>
      </footer>
    </div>
  </div>
</BaseLayout>
