---
/**
 * Project: Pharos Kitchen Design (Project Prism)
 * Component: Pages / Coverage
 * License: FSL-1.1 (See LICENSE file for details)
 * File: coverage.astro
 * Author: Richard D. (https://github.com/iamrichardd)
 * Purpose: Visualizes equipment category coverage and sync vitality.
 * Traceability: ADR 0015, Issue #81
 * Last Updated: 2026-06-29
 */

import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Utility Scheduling Reference | Pharos Kitchen Design" description="Explore our active manufacturer coverage data, update frequency, and Model Context Protocol (MCP) specifications.">
	<section class="py-16 container mx-auto px-4 transition-colors duration-300">
		<div class="mb-12">
			<h1 class="text-4xl md:text-5xl mb-4">Utility Scheduling Reference</h1>
			<p class="text-text-muted max-w-2xl font-sans leading-relaxed">
				Pharos automatically bakes all critical utility parameters directly into your placed components. Use this reference dictionary to align your Revit schedule templates with our normalized database properties, eliminating manual copy-pasting from manufacturer brochures.
			</p>
		</div>

		<div class="overflow-x-auto">
			<table class="w-full text-left border-collapse text-xs md:text-sm font-sans">
				<thead>
					<tr class="border-b border-border-blueprint/30 bg-ph-blue/10">
						<th class="py-3 px-4 font-condensed uppercase tracking-wider text-ph-orange font-bold">Design Domain</th>
						<th class="py-3 px-4 font-condensed uppercase tracking-wider text-ph-orange font-bold">Schedule Field</th>
						<th class="py-3 px-4 font-condensed uppercase tracking-wider text-ph-orange font-bold">Revit Parameter</th>
						<th class="py-3 px-4 font-condensed uppercase tracking-wider text-ph-orange font-bold">Manual PDF Lookup Eliminated?</th>
					</tr>
				</thead>
				<tbody>
					<tr class="border-b border-border-blueprint/10 hover:bg-ph-blue/5 transition-colors">
						<td class="py-3 px-4 font-bold text-text-base">Electrical</td>
						<td class="py-3 px-4 text-text-base">Operating Voltage</td>
						<td class="py-3 px-4"><code class="bg-ph-charcoal/50 text-ph-orange px-2 py-0.5 rounded border border-border-blueprint/20 font-mono text-xs">voltage</code></td>
						<td class="py-3 px-4 text-text-muted"><span class="text-emerald-500 font-bold">Yes</span> - Populates exact voltage requirements (208V, 240V, etc.).</td>
					</tr>
					<tr class="border-b border-border-blueprint/10 hover:bg-ph-blue/5 transition-colors">
						<td class="py-3 px-4 font-bold text-text-base">Electrical</td>
						<td class="py-3 px-4 text-text-base">Phase</td>
						<td class="py-3 px-4"><code class="bg-ph-charcoal/50 text-ph-orange px-2 py-0.5 rounded border border-border-blueprint/20 font-mono text-xs">phase</code></td>
						<td class="py-3 px-4 text-text-muted"><span class="text-emerald-500 font-bold">Yes</span> - Validates Single (1ph) vs. Three Phase (3ph) loads.</td>
					</tr>
					<tr class="border-b border-border-blueprint/10 hover:bg-ph-blue/5 transition-colors">
						<td class="py-3 px-4 font-bold text-text-base">Gas</td>
						<td class="py-3 px-4 text-text-base">Gas Load (BTU/hr)</td>
						<td class="py-3 px-4"><code class="bg-ph-charcoal/50 text-ph-orange px-2 py-0.5 rounded border border-border-blueprint/20 font-mono text-xs">btu</code></td>
						<td class="py-3 px-4 text-text-muted"><span class="text-emerald-500 font-bold">Yes</span> - Populates burner inputs for ventilation sizing.</td>
					</tr>
					<tr class="border-b border-border-blueprint/10 hover:bg-ph-blue/5 transition-colors">
						<td class="py-3 px-4 font-bold text-text-base">Plumbing</td>
						<td class="py-3 px-4 text-text-base">Waste Connection</td>
						<td class="py-3 px-4"><code class="bg-ph-charcoal/50 text-ph-orange px-2 py-0.5 rounded border border-border-blueprint/20 font-mono text-xs">drain_connection</code></td>
						<td class="py-3 px-4 text-text-muted"><span class="text-emerald-500 font-bold">Yes</span> - Specifies pipe connection size and NPT threads.</td>
					</tr>
					<tr class="border-b border-border-blueprint/10 hover:bg-ph-blue/5 transition-colors">
						<td class="py-3 px-4 font-bold text-text-base">Dimensions</td>
						<td class="py-3 px-4 text-text-base">Equipment Width</td>
						<td class="py-3 px-4"><code class="bg-ph-charcoal/50 text-ph-orange px-2 py-0.5 rounded border border-border-blueprint/20 font-mono text-xs">width</code></td>
						<td class="py-3 px-4 text-text-muted"><span class="text-emerald-500 font-bold">Yes</span> - Feeds exact footprint dimensions for layout clearance.</td>
					</tr>
					<tr class="border-b border-border-blueprint/10 hover:bg-ph-blue/5 transition-colors">
						<td class="py-3 px-4 font-bold text-text-base">Dimensions</td>
						<td class="py-3 px-4 text-text-base">Equipment Depth</td>
						<td class="py-3 px-4"><code class="bg-ph-charcoal/50 text-ph-orange px-2 py-0.5 rounded border border-border-blueprint/20 font-mono text-xs">depth</code></td>
						<td class="py-3 px-4 text-text-muted"><span class="text-emerald-500 font-bold">Yes</span> - Feeds exact footprint dimensions for layout clearance.</td>
					</tr>
					<tr class="hover:bg-ph-blue/5 transition-colors">
						<td class="py-3 px-4 font-bold text-text-base">Dimensions</td>
						<td class="py-3 px-4 text-text-base">Equipment Height</td>
						<td class="py-3 px-4"><code class="bg-ph-charcoal/50 text-ph-orange px-2 py-0.5 rounded border border-border-blueprint/20 font-mono text-xs">height</code></td>
						<td class="py-3 px-4 text-text-muted"><span class="text-emerald-500 font-bold">Yes</span> - Feeds exact footprint dimensions for layout clearance.</td>
					</tr>
				</tbody>
			</table>
		</div>
	</section>
</BaseLayout>

