---
/* ========================================================================
 * Project: Pharos Kitchen Design (Project Prism)
 * Component: Marketing / Roadmap
 * License: FSL-1.1 (See LICENSE file for details)
 * File: src/pages/roadmap.astro
 * Author: Richard D. (https://github.com/iamrichardd)
 * Purpose: High-fidelity "Professional Grade" Technical Maturity Matrix with collapse sections.
 * Traceability: ADR-0012, ADR-0051, Issue #215, Issue #311
 * Last Updated: 2026-06-30
 * ======================================================================== */

import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import fs from "node:fs";
import path from "node:path";

// Authoritative Source: Generated by scripts/sync-roadmap.ts
const TOON_PATH = path.resolve("src/content/roadmap.toon");
let roadmapItems: any[] = [];
let lastSynced = "Unknown";

try {
  const rawToon = fs.readFileSync(TOON_PATH, "utf-8");
  
  // Extract Sync Metadata
  const syncMatch = rawToon.match(/lastSynced:\s*([^\n]+)/);
  if (syncMatch && syncMatch[1]) lastSynced = new Date(syncMatch[1]).toLocaleString();

  // Updated TOON Parsing (includes ID)
  const itemRows = rawToon.matchAll(/^\s*"([^"]+)",\s*"([^"]+)",\s*"([^"]+)",\s*"([^"]+)",\s*"([^"]+)",\s*"([^"]+)"/gm);
  
  for (const match of itemRows) {
    const rawId = parseInt(match[1] || "", 10);
    roadmapItems.push({
      id: rawId > 0 ? rawId : null,
      name: match[2],
      status: match[3],
      phase: match[4],
      tag: match[5],
      description: match[6]
    });
  }
} catch (e) {
  console.error("[PHAROS_FATAL]: Failed to load authoritative roadmap.toon", e);
}

// Deterministic Sort (Descending: Sprint 5 -> 1)
const sortedRoadmap = roadmapItems.toSorted((a, b) => {
    return b.phase.localeCompare(a.phase, undefined, { numeric: true, sensitivity: 'base' });
});

// Swimlane Segregation (ADR-0017 / Issue #215)
const activeSquad = sortedRoadmap.filter(i => i.status === 'In Progress');
const deployedSpec = sortedRoadmap.filter(i => i.status === 'Deployed');
const futureBlueprint = sortedRoadmap.filter(i => i.status === 'Blueprint Approved' || i.status === 'Research Phase');

const filterPills = [
  { label: "Deployed", value: "status=deployed" },
  { label: "Active", value: "status=progress" },
  { label: "Core", value: "tag=core" },
  { label: "Security", value: "tag=identity" }
];
---

<BaseLayout title="PKD Roadmap | Pharos Kitchen Design">
  <PageHeader title="Roadmap" description="Project Roadmap" />
  <main class="max-w-7xl mx-auto px-6 py-10 min-h-screen blueprint-grid transition-colors duration-300">
    <div class="mb-20 border-l-4 border-ph-blue pl-8 py-4 bg-ph-blue/5 backdrop-blur-sm relative">
      <p class="text-xl text-text-muted max-w-3xl leading-relaxed">
        Our roadmap tracks the features and tools designed to help you work faster, collaborate seamlessly, and design without software bloat. We prioritize core system speed and asset accuracy first, ensuring your kitchen models load instantly and run perfectly.
      </p>
    </div>

    <!-- Command Bar Integration -->
    <div class="mb-16 sticky top-24 z-40">
      <pkd-command-bar 
        id="roadmap-command-bar"
        type="roadmap"
        placeholder="Filter by status=deployed, tag=core, stream=phase_1..."
        pills={JSON.stringify(filterPills)}
      />
    </div>

    <div class="space-y-32">
      <!-- 1. IN PROGRESS -->
      <section class="filter-section transition-all duration-500">
        <div class="flex items-center gap-4 mb-10 cursor-pointer select-none" data-toggle-section>
          <h2 class="text-2xl font-black font-mono tracking-tighter text-ph-blue uppercase">In Progress</h2>
          <div class="h-px flex-1 bg-ph-blue/20"></div>
          <span class="text-[10px] font-mono text-text-muted uppercase tracking-widest">{activeSquad.length} In Progress <span class="toggle-icon text-xs font-mono ml-2 text-text-muted text-ph-blue">▼</span></span>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {activeSquad.map((item) => (
            <div class="roadmap-card group relative bg-bg-base/40 border border-ph-blue/20 p-8 hover:border-ph-blue transition-all duration-300 shadow-lg hover:shadow-ph-blue/10 flex flex-col justify-between" data-raw={`status=progress tag=${item.tag.toLowerCase()} stream=${item.phase.toLowerCase()} name=${item.name.toLowerCase()} desc=${item.description.toLowerCase()}`}>
              <div class="absolute top-0 left-0 bg-ph-blue px-3 py-1 text-[9px] font-mono text-ph-charcoal uppercase tracking-widest font-bold">
                [{item.tag}]
              </div>
              <div class="mt-4">
                <div class="text-xs font-mono text-ph-orange mb-2 uppercase tracking-widest font-bold">{item.phase}</div>
                <h3 class="text-2xl font-bold text-text-base mb-4 tracking-tight">{item.name}</h3>
                <p class="text-text-muted text-sm leading-relaxed mb-6 italic">{item.description}</p>
              </div>
              <div class="mt-4 pt-4 border-t border-border-blueprint/10 flex justify-between items-center opacity-40 group-hover:opacity-100 transition-opacity">
                <div class="text-[9px] font-mono text-text-muted uppercase">
                  {item.id ? `SPEC_ID: #${item.id}` : 'SPEC_ID: PENDING'}
                </div>
                <div class="h-px flex-1 mx-4 bg-border-blueprint/20"></div>
                <div class="w-2 h-2 border border-ph-blue/40 rounded-full animate-pulse"></div>
              </div>
            </div>
          ))}
        </div>
        <div class="no-match-msg hidden py-10 text-center border border-dashed border-ph-blue/10 rounded-xl bg-ph-blue/5">
           <p class="text-text-muted font-mono text-xs uppercase tracking-widest">No Active Squad Matches Found</p>
        </div>
      </section>

      <!-- 2. TO DO -->
      <section class="filter-section transition-all duration-500">
        <div class="flex items-center gap-4 mb-10 cursor-pointer select-none" data-toggle-section>
          <h2 class="text-2xl font-black font-mono tracking-tighter text-amber-500 uppercase">To Do</h2>
          <div class="h-px flex-1 bg-amber-500/20"></div>
          <span class="text-[10px] font-mono text-text-muted uppercase tracking-widest">{futureBlueprint.length} Approved <span class="toggle-icon text-xs font-mono ml-2 text-text-muted text-amber-500">▼</span></span>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {futureBlueprint.map((item) => (
            <div class="roadmap-card group relative bg-bg-base/40 border border-amber-500/20 p-8 hover:border-amber-500 transition-all duration-300 shadow-lg hover:shadow-amber-500/10 flex flex-col justify-between" data-raw={`status=blueprint tag=${item.tag.toLowerCase()} stream=${item.phase.toLowerCase()} name=${item.name.toLowerCase()} desc=${item.description.toLowerCase()}`}>
              <div class="absolute top-0 left-0 bg-amber-500 px-3 py-1 text-[9px] font-mono text-ph-charcoal uppercase tracking-widest font-bold">
                [{item.tag}]
              </div>
              <div class="mt-4">
                <div class="text-xs font-mono text-ph-orange mb-2 uppercase tracking-widest font-bold">{item.phase}</div>
                <h3 class="text-2xl font-bold text-text-base mb-4 tracking-tight">{item.name}</h3>
                <p class="text-text-muted text-sm leading-relaxed mb-6 italic">{item.description}</p>
              </div>
              <div class="mt-4 pt-4 border-t border-border-blueprint/10 flex justify-between items-center opacity-40 group-hover:opacity-100 transition-opacity">
                <div class="text-[9px] font-mono text-text-muted uppercase">
                  {item.id ? `SPEC_ID: #${item.id}` : 'SPEC_ID: PENDING'}
                </div>
                <div class="h-px flex-1 mx-4 bg-border-blueprint/20"></div>
                <div class="w-2 h-2 border border-amber-500/40 rounded-full"></div>
              </div>
            </div>
          ))}
        </div>
        <div class="no-match-msg hidden py-10 text-center border border-dashed border-amber-500/10 rounded-xl bg-amber-500/5">
           <p class="text-text-muted font-mono text-xs uppercase tracking-widest">No Future Blueprint Matches Found</p>
        </div>
      </section>

      <!-- 3. COMPLETED -->
      <section class="filter-section transition-all duration-500">
        <div class="flex items-center gap-4 mb-10 cursor-pointer select-none" data-toggle-section>
          <h2 class="text-2xl font-black font-mono tracking-tighter text-ph-pulse uppercase">Completed</h2>
          <div class="h-px flex-1 bg-ph-pulse/20"></div>
          <span class="text-[10px] font-mono text-text-muted uppercase tracking-widest">{deployedSpec.length} Verified <span class="toggle-icon text-xs font-mono ml-2 text-text-muted text-ph-pulse">▼</span></span>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {deployedSpec.map((item) => (
            <div class="roadmap-card group relative bg-bg-base/40 border border-ph-pulse/20 p-8 hover:border-ph-pulse transition-all duration-300 shadow-lg hover:shadow-ph-pulse/10 flex flex-col justify-between" data-raw={`status=deployed tag=${item.tag.toLowerCase()} stream=${item.phase.toLowerCase()} name=${item.name.toLowerCase()} desc=${item.description.toLowerCase()}`}>
              <div class="absolute top-0 left-0 bg-ph-pulse px-3 py-1 text-[9px] font-mono text-ph-charcoal uppercase tracking-widest font-bold">
                [{item.tag}]
              </div>
              <div class="mt-4">
                <div class="text-xs font-mono text-ph-orange mb-2 uppercase tracking-widest font-bold">{item.phase}</div>
                <h3 class="text-2xl font-bold text-text-base mb-4 tracking-tight">{item.name}</h3>
                <p class="text-text-muted text-sm leading-relaxed mb-6 italic">{item.description}</p>
              </div>
              <div class="mt-4 pt-4 border-t border-border-blueprint/10 flex justify-between items-center opacity-40 group-hover:opacity-100 transition-opacity">
                <div class="text-[9px] font-mono text-text-muted uppercase">
                  {item.id ? `SPEC_ID: #${item.id}` : 'SPEC_ID: PENDING'}
                </div>
                <div class="h-px flex-1 mx-4 bg-border-blueprint/20"></div>
                <div class="w-2 h-2 bg-ph-pulse rounded-full"></div>
              </div>
            </div>
          ))}
        </div>
        <div class="no-match-msg hidden py-10 text-center border border-dashed border-ph-pulse/10 rounded-xl bg-ph-pulse/5">
           <p class="text-text-muted font-mono text-xs uppercase tracking-widest">No Deployed Spec Matches Found</p>
        </div>
      </section>
    </div>

    <!-- Final CTA -->
    <div class="mt-32 p-12 bg-bg-base/40 border-b-8 border-ph-blue relative overflow-hidden blueprint-border">
      <div class="relative z-10">
        <h2 class="text-3xl font-bold mb-6 font-mono tracking-tighter text-text-base">Contribute to the Blueprint</h2>
        <p class="text-text-muted max-w-2xl mb-8 leading-relaxed">
          PKD is built for the IKD community. Our roadmap is an open specification for the future of AEC data sovereignty.
        </p>
        <a href="https://github.com/iamrichardD/pharos-kitchen-design" class="inline-block px-10 py-4 bg-ph-blue text-ph-charcoal font-bold transition-colors uppercase tracking-widest text-sm hover:bg-white">
          Join the Development
        </a>
      </div>
      <!-- Grid Background Decoration -->
      <div class="absolute inset-0 opacity-5 pointer-events-none blueprint-grid"></div>
    </div>
  </main>
</BaseLayout>

<style>
  .roadmap-card {
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .filter-section.collapsed .grid,
  .filter-section.collapsed .no-match-msg {
    display: none !important;
  }
</style>

<script>
  import '@pkd/protocol';
  import { matchWildcard } from '../utils/wildcardFilter';

  const commandBar = document.getElementById('roadmap-command-bar');
  const targetSelector = '.roadmap-card';

  function applyFilterLocal(query: string, targetSelector: string, postFilterCallback?: () => void) {
    const entries = document.querySelectorAll(targetSelector);
    const normalizedQuery = query.toLowerCase().trim();
    
    entries.forEach(entry => {
      const htmlEntry = entry as HTMLElement;
      const raw = htmlEntry.dataset.raw?.toLowerCase() || htmlEntry.innerText.toLowerCase() || '';
      let match = true;

      if (normalizedQuery.length > 0) {
        if (normalizedQuery.includes('=')) {
          const parts = normalizedQuery.split('=');
          const key = parts[0]?.trim();
          const value = parts[1]?.trim();
          
          if (key && value) {
            const isWildcard = value.includes('*') || value.includes('+') || value.includes('?') || value.includes('[');
            
            if (isWildcard) {
               const pattern = new RegExp(`${key}[:=]\\s?([^\\s]+)`, 'i');
               const fieldMatch = raw.match(pattern);
               match = (fieldMatch && fieldMatch[1]) ? matchWildcard(fieldMatch[1], value) : false;
            } else {
               match = raw.includes(`${key}: ${value}`) || 
                       raw.includes(`${key}=${value}`) || 
                       (raw.includes(`[${value.toUpperCase()}]`));
            }
          }
        } else {
          const isWildcard = normalizedQuery.includes('*') || normalizedQuery.includes('+') || normalizedQuery.includes('?') || normalizedQuery.includes('[');
          if (isWildcard) {
             match = matchWildcard(raw, `.*${normalizedQuery}.*`);
          } else {
             match = raw.includes(normalizedQuery);
          }
        }
      }

      htmlEntry.style.display = match ? 'block' : 'none';
      if (match) {
        htmlEntry.classList.add('animate-in', 'fade-in');
      } else {
        htmlEntry.classList.remove('animate-in', 'fade-in');
      }
    });

    if (postFilterCallback) {
      postFilterCallback();
    }
  }

  function collapseEmptySections() {
    const sections = document.querySelectorAll('.filter-section');
    sections.forEach(section => {
      const cards = section.querySelectorAll(targetSelector);
      let visibleCount = 0;
      cards.forEach(card => {
        if ((card as HTMLElement).style.display !== 'none') {
          visibleCount++;
        }
      });

      const noMatchMsg = section.querySelector('.no-match-msg');
      const grid = section.querySelector('.grid');
      
      if (visibleCount === 0) {
        if (noMatchMsg) noMatchMsg.classList.remove('hidden');
        if (grid) grid.classList.add('hidden');
      } else {
        if (noMatchMsg) noMatchMsg.classList.add('hidden');
        if (grid) grid.classList.remove('hidden');
      }
    });
  }

  commandBar?.addEventListener('pkd-query', (e: Event) => {
    const customEvent = e as CustomEvent;
    applyFilterLocal(customEvent.detail.value, targetSelector, collapseEmptySections);
  });

  // Toggle collapse/expand interaction
  document.querySelectorAll('[data-toggle-section]').forEach((header) => {
    header.addEventListener('click', () => {
      const section = header.closest('.filter-section');
      if (!section) return;
      section.classList.toggle('collapsed');
      const icon = header.querySelector('.toggle-icon');
      if (icon) {
        icon.textContent = section.classList.contains('collapsed') ? '▶' : '▼';
      }
    });
  });
</script>
