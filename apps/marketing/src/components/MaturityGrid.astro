 * License: FSL-1.1 (See LICENSE file for details)
 * File: MaturityGrid.astro
 * Author: Richard D. (https://github.com/iamrichardd)
 * Purpose: Visualizes equipment category coverage and sync status.
 * Traceability: ADR 0015
 * Last Updated: 2026-06-29
 */

import FidelityBadge from './FidelityBadge.astro';
import { categories } from '../data/categories';
---

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 transition-colors duration-300">
	{categories.map((cat) => (
		<div class="blueprint-border p-4 bg-bg-base/40 transition-colors duration-300">
			<div class="flex justify-between items-start mb-2">
				<h4 class="text-sm font-bold text-text-muted font-mono uppercase">{cat.name}</h4>
				<FidelityBadge level={cat.fidelity} />
			</div>
			
			<div class="mb-4">
				<p class="text-[11px] text-text font-mono">{cat.models}</p>
				<p class="text-[10px] text-text-muted/70 font-mono italic">{cat.category}</p>
			</div>
			
			<div class="space-y-2">
				<div class="flex justify-between text-[10px] text-text-muted font-mono uppercase mb-1">
					<span>Schema Coverage</span>
					<span>{cat.coverage}%</span>
				</div>
				<div class="w-full bg-border-blueprint/10 h-1.5 rounded-full overflow-hidden">
					<div 
						class="h-full bg-ph-blue transition-all duration-500" 
						style={`width: ${cat.coverage}%`}
					></div>
				</div>
			</div>
			
			<div class="mt-4 pt-3 border-t border-border-blueprint/10 flex justify-between items-center">
				<div class="flex items-center gap-1.5">
					<span class="w-1.5 h-1.5 rounded-full bg-ph-orange animate-pulse"></span>
					<span class="text-[10px] text-text-muted font-mono uppercase">Live Pulse</span>
				</div>
				<span class="text-[10px] text-text-muted font-mono">{cat.lastSync}</span>
			</div>
		</div>
	))}
</div>
