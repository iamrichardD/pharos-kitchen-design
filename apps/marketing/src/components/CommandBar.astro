---
/* ========================================================================
 * Project: Pharos Kitchen Design (Project Prism)
 * Component: Marketing / UI / CommandBar
 * File: src/components/CommandBar.astro
 * Author: Richard D. (https://github.com/iamrichardd)
 * License: FSL-1.1
 * Purpose: Reusable RFC-2378 query interface for filtering lists.
 * ======================================================================== */

interface Props {
  placeholder?: string;
  targetSelector: string;
  pills?: { label: string; value: string }[];
}

const { 
  placeholder = "Filter by keywords or key=value...", 
  targetSelector,
  pills = []
} = Astro.props;
---

<div id="command-bar-container" class="mb-16 sticky top-24 z-40">
  <div class="relative group">
    <div class="absolute -inset-1 bg-gradient-to-r from-ph-pulse/20 via-ph-pulse/10 to-transparent rounded-xl blur opacity-25 group-focus-within:opacity-100 transition duration-500"></div>
    <div class="relative bg-bg-base/80 backdrop-blur-xl border border-ph-pulse/20 rounded-xl flex items-center p-2 shadow-2xl">
      <div class="flex items-center gap-3 px-4 py-2 bg-ph-pulse/5 rounded-lg border border-ph-pulse/10">
         <span class="text-ph-pulse/50 font-mono text-xs">pkd query ></span>
      </div>
      <input 
        type="text" 
        id="command-bar-input"
        placeholder={placeholder}
        class="bg-transparent border-none outline-none text-text-base font-mono text-sm flex-grow px-4 placeholder:text-text-muted/50"
        aria-label="Pharos Command Bar"
      />
      <div class="flex gap-2 mr-2">
         {pills.map(p => (
           <button class="command-pill hidden md:block px-3 py-1 bg-ph-pulse/5 border border-ph-pulse/20 text-[10px] uppercase text-text-muted hover:text-ph-pulse transition-all rounded" data-value={p.value}>
             {p.label}
           </button>
         ))}
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ targetSelector }}>
  // PHAROS COMMAND BAR LOGIC (RFC-2378 Filter Patterns)
  const input = document.getElementById('command-bar-input');
  const pills = document.querySelectorAll('.command-pill');

  function applyFilter(query) {
    const entries = document.querySelectorAll(targetSelector);
    const normalizedQuery = query.toLowerCase().trim();
    
    entries.forEach(entry => {
      const raw = entry.dataset.raw?.toLowerCase() || entry.innerText.toLowerCase() || '';
      let match = true;

      if (normalizedQuery.length > 0) {
        if (normalizedQuery.includes('=')) {
          // RFC-2378 Key=Value Search
          const [key, value] = normalizedQuery.split('=');
          if (key && value) {
            const k = key.trim();
            const v = value.trim();
            // Match "key: value", "key=value", or direct presence for tags
            match = raw.includes(`${k}: ${v}`) || 
                    raw.includes(`${k}=${v}`) || 
                    (raw.includes(`[${v.toUpperCase()}]`));
          }
        } else {
          // Global Keyword Search
          match = raw.includes(normalizedQuery);
        }
      }

      entry.style.display = match ? 'block' : 'none';
      if (match) {
        entry.classList.add('animate-in', 'fade-in');
      } else {
        entry.classList.remove('animate-in', 'fade-in');
      }
    });

    // Handle section visibility (optional, for swimlanes)
    const sections = document.querySelectorAll('.filter-section');
    sections.forEach(section => {
      const visibleItems = section.querySelectorAll(`${targetSelector}:not([style*="display: none"])`);
      const noMatchMsg = section.querySelector('.no-match-msg');
      
      if (visibleItems.length === 0 && normalizedQuery.length > 0) {
        if (noMatchMsg) noMatchMsg.style.display = 'block';
        section.style.opacity = '0.5';
      } else {
        if (noMatchMsg) noMatchMsg.style.display = 'none';
        section.style.opacity = '1';
      }
    });
  }

  input?.addEventListener('input', (e) => {
    applyFilter(e.target.value);
  });

  pills.forEach(pill => {
    pill.addEventListener('click', () => {
      const value = pill.dataset.value;
      if (value) {
        input.value = value;
        applyFilter(input.value);
      }
    });
  });

  // Hotkey support (Slash to focus)
  window.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement?.tagName !== 'INPUT') {
      e.preventDefault();
      input?.focus();
    }
  });
</script>
