---
/* ========================================================================
 * Project: Pharos Kitchen Design (Project Prism)
 * Component: Marketing / UI / CommandBar
 * File: src/components/CommandBar.astro
 * Author: Richard D. (https://github.com/iamrichardd)
 * License: FSL-1.1
 * Purpose: Reusable RFC-2378 query interface for filtering lists.
 * ======================================================================== */

interface Props {
  placeholder?: string;
  targetSelector: string;
  pills?: { label: string; value: string }[];
}

const { 
  placeholder = "Filter by keywords or key=value...", 
  targetSelector,
  pills = []
} = Astro.props;
---

<div id="command-bar-container" class="mb-16 sticky top-24 z-40">
  <div class="relative group">
    <div class="absolute -inset-1 bg-gradient-to-r from-ph-pulse/20 via-ph-pulse/10 to-transparent rounded-xl blur opacity-25 group-focus-within:opacity-100 transition duration-500"></div>
    <div class="relative bg-bg-base/80 backdrop-blur-xl border border-ph-pulse/20 rounded-xl flex items-center p-2 shadow-2xl">
      <div class="flex items-center gap-3 px-4 py-2 bg-ph-pulse/5 rounded-lg border border-ph-pulse/10">
         <span class="text-ph-pulse/50 font-mono text-xs">pkd query ></span>
      </div>
      <input 
        type="text" 
        id="command-bar-input"
        placeholder={placeholder}
        class="bg-transparent border-none outline-none text-text-base font-mono text-sm flex-grow px-4 placeholder:text-text-muted/50"
        aria-label="Pharos Command Bar"
        autocomplete="off"
      />
      <div class="flex gap-2 mr-2">
         {pills.map(p => (
           <button class="command-pill hidden md:block px-3 py-1 bg-ph-pulse/5 border border-ph-pulse/20 text-[10px] uppercase text-text-muted hover:text-ph-pulse transition-all rounded" data-value={p.value}>
             {p.label}
           </button>
         ))}
      </div>
    </div>

    <!-- Contextual Helper UI (ADR-0048 / Command Bar Ergonomics) -->
    <div id="command-helper" class="absolute top-full left-0 right-0 mt-4 p-6 bg-bg-base/90 backdrop-blur-2xl border border-ph-pulse/20 rounded-xl shadow-2xl opacity-0 translate-y-2 pointer-events-none transition-all duration-300 z-50 group-focus-within:opacity-100 group-focus-within:translate-y-0 group-focus-within:pointer-events-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div>
          <h4 class="text-[10px] font-mono text-ph-pulse uppercase tracking-widest mb-4">RFC-2378 Operators</h4>
          <ul class="space-y-3">
            <li class="flex items-center gap-3">
              <code class="text-xs font-mono text-text-base bg-ph-pulse/10 px-2 py-1 rounded">tag=</code>
              <span class="text-[10px] text-text-muted uppercase">Filter by component category (e.g., core, identity)</span>
            </li>
            <li class="flex items-center gap-3">
              <code class="text-xs font-mono text-text-base bg-ph-pulse/10 px-2 py-1 rounded">status=</code>
              <span class="text-[10px] text-text-muted uppercase">Filter by lifecycle state (e.g., deployed, progress)</span>
            </li>
            <li class="flex items-center gap-3">
              <code class="text-xs font-mono text-text-base bg-ph-pulse/10 px-2 py-1 rounded">stream=</code>
              <span class="text-[10px] text-text-muted uppercase">Filter by development stream (e.g., sprint_5.01)</span>
            </li>
          </ul>
        </div>
        <div>
          <h4 class="text-[10px] font-mono text-ph-pulse uppercase tracking-widest mb-4">Wildcards & Sets</h4>
          <ul class="space-y-3">
            <li class="flex items-center gap-3">
              <code class="text-xs font-mono text-text-base bg-ph-pulse/10 px-2 py-1 rounded">*</code>
              <span class="text-[10px] text-text-muted uppercase">Zero or more characters (e.g., auth*)</span>
            </li>
            <li class="flex items-center gap-3">
              <code class="text-xs font-mono text-text-base bg-ph-pulse/10 px-2 py-1 rounded">+</code>
              <span class="text-[10px] text-text-muted uppercase">One or more unknown characters</span>
            </li>
            <li class="flex items-center gap-3">
              <code class="text-xs font-mono text-text-base bg-ph-pulse/10 px-2 py-1 rounded">?</code>
              <span class="text-[10px] text-text-muted uppercase">Exactly one character (e.g., spr?nt)</span>
            </li>
            <li class="flex items-center gap-3">
              <code class="text-xs font-mono text-text-base bg-ph-pulse/10 px-2 py-1 rounded">[ ]</code>
              <span class="text-[10px] text-text-muted uppercase">Set of characters (e.g., [ei] match 'e' or 'i')</span>
            </li>
          </ul>
        </div>
      </div>
      <div class="mt-6 pt-4 border-t border-ph-pulse/10 flex justify-between items-center">
        <p class="text-[9px] font-mono text-text-muted uppercase">CCSO Nameserver Architecture // RFC-2378 Standard</p>
        <div class="flex gap-4">
           <span class="text-[9px] font-mono text-ph-pulse/40">SLASH to focus</span>
           <span class="text-[9px] font-mono text-ph-pulse/40">ESC to blur</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ targetSelector }}>
  // PHAROS COMMAND BAR LOGIC (RFC-2378 Filter Patterns)
  // Rationale: Separated logic from event handlers for testability (Kent Beck/Crucible #215)
  const input = document.getElementById('command-bar-input');
  const pills = document.querySelectorAll('.command-pill');
  const sections = document.querySelectorAll('.filter-section');

  function matchWildcard(text, pattern) {
    // RFC-2378 Wildcard Support: *, +, ?, []
    // Implementation: Convert RFC-2378 wildcards to Regex after escaping metacharacters
    const regexPattern = pattern.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
      .replace(/\\\*/g, '.*')
      .replace(/\\\+/g, '.+')
      .replace(/\\\?/g, '.')
      .replace(/\\\[/g, '[')
      .replace(/\\\]/g, ']');
    
    const regex = new RegExp(`^${regexPattern}$`, 'i');
    return regex.test(text);
  }

  function applyFilter(query) {
    const entries = document.querySelectorAll(targetSelector);
    const normalizedQuery = query.toLowerCase().trim();
    
    entries.forEach(entry => {
      const raw = entry.dataset.raw?.toLowerCase() || entry.innerText.toLowerCase() || '';
      let match = true;

      if (normalizedQuery.length > 0) {
        if (normalizedQuery.includes('=')) {
          // RFC-2378 Key=Value Search
          const parts = normalizedQuery.split('=');
          const key = parts[0]?.trim();
          const value = parts[1]?.trim();
          
          if (key && value) {
            // Match "key: value", "key=value", or direct presence for tags
            // We use standard string include here unless wildcards are present
            const isWildcard = value.includes('*') || value.includes('+') || value.includes('?') || value.includes('[');
            
            if (isWildcard) {
               // Extract value from "key: value" or "key=value" pattern in raw data
               const pattern = new RegExp(`${key}[:=]\\s?([^\\s]+)`, 'i');
               const fieldMatch = raw.match(pattern);
               match = fieldMatch ? matchWildcard(fieldMatch[1], value) : false;
            } else {
               match = raw.includes(`${key}: ${value}`) || 
                       raw.includes(`${key}=${value}`) || 
                       (raw.includes(`[${value.toUpperCase()}]`));
            }
          }
        } else {
          // Global Keyword Search with Wildcard Support
          const isWildcard = normalizedQuery.includes('*') || normalizedQuery.includes('+') || normalizedQuery.includes('?') || normalizedQuery.includes('[');
          if (isWildcard) {
             match = matchWildcard(raw, `.*${normalizedQuery}.*`);
          } else {
             match = raw.includes(normalizedQuery);
          }
        }
      }

      entry.style.display = match ? 'block' : 'none';
      if (match) {
        entry.classList.add('animate-in', 'fade-in');
      } else {
        entry.classList.remove('animate-in', 'fade-in');
      }
    });

    // Handle section visibility: Collapse empty swimlanes (Kathy Sierra / Crucible #215)
    sections.forEach(section => {
      const visibleItems = section.querySelectorAll(`${targetSelector}:not([style*="display: none"])`);
      if (visibleItems.length === 0 && normalizedQuery.length > 0) {
        section.style.display = 'none';
      } else {
        section.style.display = 'block';
      }
    });
  }

  input?.addEventListener('input', (e) => {
    applyFilter(e.target.value);
  });

  function setQuery(value) {
    if (input) {
      input.value = value;
      applyFilter(value);
      input.focus();
    }
  }

  pills.forEach(pill => {
    pill.addEventListener('click', () => {
      setQuery(pill.dataset.value);
    });
  });

  // Hotkey support
  window.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement?.tagName !== 'INPUT') {
      e.preventDefault();
      input?.focus();
    }
    if (e.key === 'Escape' && document.activeElement === input) {
      input.blur();
    }
  });

  // Export for testing if needed (though Astro scripts are isolated by default)
  window.pkd_filter = { applyFilter, matchWildcard };
</script>
