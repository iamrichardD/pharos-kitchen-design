---
/* ========================================================================
 * Project: Pharos Kitchen Design (Project Prism)
 * Component: Marketing / Blog
 * File: apps/marketing/src/components/ToonLoader.astro
 * Author: Richard D. (https://github.com/iamrichardd)
 * License: FSL-1.1 (See LICENSE file for details)
 * Purpose: Client-side WASM loader for TOON-encoded blog posts. Updated for Enhanced Diagnostics.
 * Traceability: Issue #175, Issue #139
 * Last Updated: 2026-06-02
 * ======================================================================== */

interface Props {
  content: string;
  id?: string;
}

const { content, id } = Astro.props;
---

<div class="toon-container bg-bg-base/40 border border-ph-pulse/20 rounded-lg p-6 font-mono text-sm text-text-base shadow-2xl transition-colors duration-300" data-toon={content} data-id={id}>
  <div class="toon-status flex items-center gap-2 mb-4">
    <div class="w-2 h-2 rounded-full bg-ph-pulse animate-pulse"></div>
    <span class="text-xs uppercase tracking-tighter opacity-60">Initializing Pharos WASM Runtime...</span>
  </div>
  
  <div class="toon-output hidden">
    <div class="toon-header mb-6 border-b border-ph-pulse/10 pb-4"></div>
    <div class="toon-body prose prose-slate dark:prose-invert max-w-none text-text-base leading-relaxed mb-8"></div>
    <div class="toon-visuals mb-12"></div>
    <div class="toon-lists mt-8 space-y-10"></div>
    {id && (
      <div class="mt-8 pt-4 border-t border-ph-pulse/10 flex justify-end items-center text-[10px] uppercase tracking-wider opacity-40">
        <span>#{id}</span>
      </div>
    )}
  </div>

  <div class="toon-fallback hidden py-12 text-center border-2 border-dashed border-red-500/20 rounded-lg bg-red-500/5">
    <div class="text-4xl mb-4">📡</div>
    <h2 class="text-red-500 font-bold text-lg uppercase tracking-widest">Pharos Signal Interrupted</h2>
    <p class="toon-error-msg text-red-500/60 text-xs mt-2 max-w-xs mx-auto">
      The Authoritative Log could not be verified. WASM parser failed to initialize or the payload is malformed.
    </p>
    <button onclick="window.location.reload()" class="mt-6 px-4 py-2 bg-red-900/30 border border-red-500/50 text-red-500 text-[10px] uppercase hover:bg-red-500 hover:text-white transition-all">
      Attempt Re-Sync
    </button>
</div>

<script>
  // @ts-ignore
  import init, { parse_toon } from '@pkd/toon';
  import { formatDate } from '../utils/date';

  let wasmInitialized = false;

  function escapeHtml(str: string | undefined): string {
    if (!str) return '';
    return str.replace(/[&<>"']/g, (m) => {
      switch (m) {
        case '&': return '&amp;';
        case '<': return '&lt;';
        case '>': return '&gt;';
        case '"': return '&quot;';
        case "'": return '&#039;';
        default: return m;
      }
    });
  }

  async function loadAllToons() {
    const containers = document.querySelectorAll('.toon-container');
    if (containers.length === 0) return;

    try {
      if (!wasmInitialized) {
        // Initialize WASM once for the entire page
        await init();
        wasmInitialized = true;
      }
      
      containers.forEach(container => {
        // Skip if already rendered
        if (container.querySelector('.toon-status')?.classList.contains('hidden')) return;

        const status = container.querySelector('.toon-status');
        const output = container.querySelector('.toon-output');
        const fallback = container.querySelector('.toon-fallback');
        const header = container.querySelector('.toon-header');
        const body = container.querySelector('.toon-body');
        const visuals = container.querySelector('.toon-visuals');
        const lists = container.querySelector('.toon-lists');

        const rawToon = (container as HTMLElement).dataset.toon;

        try {
          if (!rawToon) throw new Error("No TOON content found");

          // Parse using the Rust/WASM module
          const doc = parse_toon(rawToon);

          if (status) status.classList.add('hidden');
          if (output) output.classList.remove('hidden');

          // 1. Render Header Metadata
          if (header && doc.metadata) {
            const formattedDate = formatDate(doc.metadata.date);

            header.innerHTML = `
              <div class="flex justify-between items-start mb-2">
                <h1 class="text-2xl font-bold text-text-base tracking-tight">${escapeHtml(doc.metadata.title || 'Pharos Update')}</h1>
                <span class="px-2 py-0.5 bg-ph-pulse/5 border border-ph-pulse/20 text-[10px] uppercase text-ph-pulse font-bold rounded">
                  Verified Log
                </span>
              </div>
              <div class="flex gap-4 text-[10px] uppercase tracking-wider opacity-60">
                <span>By: ${escapeHtml(doc.metadata.author || 'PMA')}</span>
                <span>Release Date: ${escapeHtml(formattedDate)}</span>
                <span class="text-ph-pulse">Category: ${escapeHtml(doc.metadata.stream || 'Engineering')}</span>
              </div>
            `;
          }

         // 2. Render Primary Body (Extract from 'body' list if it exists)
         if (body) {
              if (doc.lists?.body?.items?.[0]?.[0]) {
                body.innerHTML = `<p>${escapeHtml(doc.lists.body.items[0][0])}</p>`;
              } else {
                body.innerHTML = `<p class="italic opacity-50 text-xs text-center">No narrative content in this log.</p>`;
              }
         }

          // 3. Render Visual Assets (Infographics)
          if (visuals && doc.lists?.infographics) {
            visuals.innerHTML = doc.lists.infographics.items.map((row: string[]) => {
              const imgPath = row[2] || '';
              const isResponsive = imgPath.endsWith('-dark.jpg') || imgPath.endsWith('-dark.png');
              if (isResponsive) {
                const lightPath = imgPath.replace('-dark.', '-light.');
                return `
                  <div class="relative group">
                    <div class="absolute -inset-1 bg-gradient-to-r from-emerald-500/20 to-emerald-400/20 dark:from-emerald-500/20 dark:to-emerald-400/20 from-ph-blue/5 to-ph-blue/10 opacity-20 blur group-hover:opacity-40 transition-all duration-1000"></div>
                    <picture>
                      <source srcset="/pharos-kitchen-design${escapeHtml(imgPath)}" media="(prefers-color-scheme: dark)">
                      <img src="/pharos-kitchen-design${escapeHtml(lightPath)}" alt="${escapeHtml(row[0])}" class="relative w-full border border-ph-pulse/10 rounded-lg shadow-2xl" />
                    </picture>
                    <div class="mt-2 text-[10px] uppercase tracking-[0.2em] opacity-40 text-center">${escapeHtml(row[0])} [${escapeHtml(row[1])}]</div>
                  </div>
                `;
              }
              return `
                <div class="relative group">
                  <div class="absolute -inset-1 bg-gradient-to-r from-emerald-500/20 to-emerald-400/20 dark:from-emerald-500/20 dark:to-emerald-400/20 from-ph-blue/5 to-ph-blue/10 opacity-20 blur group-hover:opacity-40 transition-all duration-1000"></div>
                  <img src="/pharos-kitchen-design${escapeHtml(imgPath)}" alt="${escapeHtml(row[0])}" class="relative w-full border border-ph-pulse/10 rounded-lg shadow-2xl" />
                  <div class="mt-2 text-[10px] uppercase tracking-[0.2em] opacity-40 text-center">${escapeHtml(row[0])} [${escapeHtml(row[1])}]</div>
                </div>
              `;
            }).join('');
          }

         // 4. Render Tabular Data (Metrics, Sprint Logs, etc.)
         if (lists && doc.lists) {
           lists.innerHTML = ''; // Clear existing
           Object.entries(doc.lists).forEach(([name, list]: [string, any]) => {
             if (name === 'body' || name === 'infographics') return; // Skip handled sections

             const isNarrative = list.schema.length === 1 && list.schema[0].toLowerCase() === 'content';
             const listEl = document.createElement('div');
             listEl.className = "group animate-in fade-in slide-in-from-bottom-2 duration-700";

             if (isNarrative) {
               listEl.innerHTML = `
                 <div class="flex items-center gap-2 mb-3">
                    <div class="h-[1px] flex-grow bg-ph-pulse/20"></div>
                    <h3 class="text-[10px] font-bold uppercase tracking-[0.2em] text-ph-pulse/60">${name}</h3>
                    <div class="h-[1px] w-8 bg-ph-pulse/20"></div>
                 </div>
                 <div class="toon-narrative text-text-base leading-relaxed opacity-90 prose prose-slate dark:prose-invert max-w-none">
                   ${list.items.map((row: string[]) => `<p class="mb-4 last:mb-0">${row[0]}</p>`).join('')}
                 </div>
               `;
             } else {
               listEl.innerHTML = `
                 <div class="flex items-center gap-2 mb-3">
                    <div class="h-[1px] flex-grow bg-ph-pulse/20"></div>
                    <h3 class="text-[10px] font-bold uppercase tracking-[0.2em] text-ph-pulse/60">${name}</h3>
                    <div class="h-[1px] w-8 bg-ph-pulse/20"></div>
                 </div>
                 <div class="overflow-hidden border border-ph-pulse/10 rounded-sm bg-ph-pulse/5">
                   <table class="w-full text-left border-collapse text-[11px]">
                     <thead>
                       <tr class="bg-ph-pulse/5">
                         ${list.schema.map((s: string) => `<th class="py-2.5 px-4 uppercase opacity-40 font-bold border-r border-ph-pulse/10 last:border-0">${s}</th>`).join('')}
                       </tr>
                     </thead>
                     <tbody>
                       ${list.items.map((row: string[]) => `
                         <tr class="border-t border-ph-pulse/5 hover:bg-ph-pulse/5 transition-colors group/row">
                           ${row.map((cell, idx) => {
                             const isTrendColumn = idx === 2;
                             const isPositive = cell.toLowerCase().includes('improvement') || cell.toLowerCase().includes('authoritative');
                             const textColor = (isTrendColumn && isPositive) ? 'text-emerald-500 font-bold' : 'text-text-base opacity-80 group-hover/row:opacity-100';
                             return `<td class="py-2 px-4 border-r border-ph-pulse/5 last:border-0 ${textColor} transition-colors">${cell}</td>`;
                           }).join('')}
                         </tr>
                       `).join('')}
                     </tbody>
                   </table>
                 </div>
               `;
             }
             lists.appendChild(listEl);
           });
         }
        } catch (innerError) {
          console.error("Individual TOON Parse Error:", innerError);
          const errorMsg = container.querySelector('.toon-error-msg');
          if (errorMsg) {
            const err = innerError as any;
            const message = err.message || String(innerError);
            const details = err.details;

            if (details && details.line) {
              errorMsg.innerHTML = `
                <div class="font-bold mb-1 text-red-500 uppercase tracking-tighter">Verification Failure (L${details.line}${details.col ? ':C' + details.col : ''})</div>
                <div class="opacity-80 mb-3">${message}</div>
                ${details.snippet ? `<pre class="bg-black/40 p-3 rounded text-[10px] text-left overflow-x-auto border border-red-500/20 text-red-400 font-mono leading-tight">${details.snippet}</pre>` : ''}
              `;
              errorMsg.classList.remove('max-w-xs', 'mx-auto'); // Allow more space for snippets
            } else {
              const rawToon = (container as HTMLElement).dataset.toon || '';
              const snippet = rawToon.substring(0, 100).replace(/\n/g, ' ');
              errorMsg.textContent = `Verification Error: ${message} | Payload: ${snippet}...`;
            }
          }
          if (status) status.classList.add('hidden');
          if (fallback) fallback.classList.remove('hidden');
        }
      });

    } catch (e) {
      console.error("Pharos WASM Global Error:", e);
    }
  }

  // Handle initialization
  loadAllToons();
  document.addEventListener('astro:after-swap', loadAllToons);
</script>
