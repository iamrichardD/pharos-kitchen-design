---
/* ========================================================================
 * Project: Pharos Kitchen Design (Project Prism)
 * Component: Demo / Layout
 * File: DemoLayout.astro
 * Author: Richard D. (https://github.com/iamrichardd)
 * License: FSL-1.1 (See LICENSE file for details)
 * Purpose: Global shell for the PKD demo sandbox inheriting shared theme tokens, marketing header, and footer.
 * Traceability: Priority 3, Issue #28, Issue #235
 * Last Updated: 2026-06-12
 * ======================================================================== */

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | PKD Demo</title>

		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Roboto+Condensed:wght@700&display=swap" rel="stylesheet">

		<style is:global>
			@import "tailwindcss";

			@theme {
				--color-ph-charcoal: rgb(var(--ph-charcoal));
				--color-ph-orange: rgb(var(--ph-orange));
				--color-ph-blue: rgb(var(--ph-blue));
				--color-ph-emerald: rgb(var(--ph-emerald));
				--color-bg-base: rgb(var(--bg-base));
				--color-text-base: rgb(var(--text-base));
				--color-text-muted: rgb(var(--text-muted));
				--color-grid-line: rgb(var(--grid-line));
				--color-border-blueprint: rgb(var(--border-blueprint));

				--font-condensed: "Roboto Condensed", sans-serif;
				--font-sans: "Inter", sans-serif;
			}

			:root {
				/* Foundation Colors */
				--ph-charcoal: 26, 26, 26;
				--ph-orange: 255, 107, 0;
				--ph-blue: 0, 95, 184;
				--ph-emerald: 16, 185, 129;

				/* Theme Tokens (Default: Dark Mode / Charcoal) */
				--bg-base: var(--ph-charcoal);
				--text-base: 243, 244, 246; /* slate-100 */
				--text-muted: 156, 163, 175; /* gray-400 */
				--grid-line: 255, 255, 255;
				--grid-opacity: 0.05;
				--border-blueprint: 0, 95, 184;
				--border-opacity: 0.3;
			}

			@media (prefers-color-scheme: light) {
				:root {
					/* Theme Tokens (Architectural Vellum / Light Mode) */
					--bg-base: 248, 250, 252; /* slate-50 */
					--text-base: 26, 26, 26; /* ph-charcoal */
					--text-muted: 75, 85, 99; /* gray-600 */
					--grid-line: 0, 95, 184;
					--grid-opacity: 0.1;
					--border-blueprint: 0, 95, 184;
					--border-opacity: 0.5;
				}
			}

			body {
				background-color: rgb(var(--bg-base));
				color: rgb(var(--text-base));
				font-family: 'Inter', system-ui, -apple-system, sans-serif;
				margin: 0;
				min-height: 100vh;
				transition: background-color 0.3s, color 0.3s;
			}

			/* Utility Classes (Parity with Marketing global.css) */
			.blueprint-grid {
				background-image: 
					linear-gradient(to right, rgba(var(--grid-line), var(--grid-opacity)) 1px, transparent 1px),
					linear-gradient(to bottom, rgba(var(--grid-line), var(--grid-opacity)) 1px, transparent 1px);
				background-size: 30px 30px;
			}

			.blueprint-border {
				border: 1px solid rgba(var(--border-blueprint), var(--border-opacity));
				position: relative;
			}

			.blueprint-border::before {
				content: '';
				position: absolute;
				top: -4px;
				left: -4px;
				width: 8px;
				height: 8px;
				background-color: rgb(var(--ph-orange));
				z-index: 10;
			}

			.blueprint-border::after {
				content: '';
				position: absolute;
				bottom: -4px;
				right: -4px;
				width: 8px;
				height: 8px;
				background-color: rgb(var(--ph-orange));
				z-index: 10;
			}
		</style>
	</head>
	<body class="blueprint-grid min-h-screen flex flex-col justify-between">
		<!-- Unified Marketing Header -->
		<header class="border-b border-ph-blue/30 py-4 bg-bg-base/80 backdrop-blur-sm sticky top-0 z-50 transition-colors duration-300">
			<div class="container mx-auto px-4 flex justify-between items-center">
				<a href="/pharos-kitchen-design/" class="flex items-center gap-2 text-current no-underline">
					<div class="w-8 h-8 bg-ph-orange flex items-center justify-center font-condensed text-ph-charcoal text-xl font-bold">P</div>
					<span class="font-condensed text-xl tracking-tight hidden sm:inline font-bold">PHAROS KITCHEN DESIGN</span>
				</a>
				<nav class="flex gap-6 font-condensed text-sm tracking-widest uppercase">
					<a href="/pharos-kitchen-design/features" class="hover:text-ph-orange transition-colors text-current no-underline">Features</a>
					<a href="/pharos-kitchen-design/docs/user-guide" class="hover:text-ph-orange transition-colors text-current no-underline">Guide</a>
					<a href="/pharos-kitchen-design/coverage" class="hover:text-ph-orange transition-colors text-current no-underline">Coverage</a>
					<a href="/pharos-kitchen-design/blog" class="hover:text-ph-orange transition-colors text-current no-underline font-bold">Pulse</a>
					<a href="/pharos-kitchen-design/bridge" class="hover:text-ph-orange transition-colors text-current no-underline">Bridge</a>
					<a href="/pharos-kitchen-design/install" class="hover:text-ph-orange transition-colors text-current no-underline">Install</a>
					<a href="/pharos-kitchen-design/roadmap" class="hover:text-ph-blue transition-colors text-current no-underline">Roadmap</a>
				</nav>
			</div>
		</header>

		<!-- Main Workspace Area -->
		<div class="flex-grow">
			<slot />
		</div>

		<!-- Unified Marketing Footer -->
		<footer class="border-t border-ph-blue/30 py-8 bg-bg-base/50 transition-colors duration-300">
			<div class="container mx-auto px-4 flex flex-col md:flex-row justify-between items-center gap-4">
				<div class="text-xs text-text-muted font-mono uppercase tracking-widest">
					PROJECT: PKD // STATUS: DETERMINISTIC // [FSL-1.1]
				</div>
				<div class="flex gap-6 items-center">
					<a href="https://iamrichardd.com" class="text-xs text-text-muted hover:text-ph-orange transition-colors no-underline">A Project by Richard D.</a>
					<a href="https://github.com/iamrichardD/pharos-kitchen-design" class="text-xs text-ph-blue hover:text-ph-orange transition-colors uppercase font-bold tracking-widest no-underline">GitHub Repository</a>
				</div>
			</div>
		</footer>
	</body>
</html>
