---
/* ========================================================================
 * Project: Pharos Kitchen Design (Project Prism)
 * Component: Demo / Pages
 * File: index.astro
 * Author: Richard D. (https://github.com/iamrichardd)
 * License: FSL-1.1 (See LICENSE file for details)
 * Purpose: Conceptual blueprint and statement of intent for the PKD interface.
 * Traceability: Priority 3, Issue #28, Issue #235
 * Last Updated: 2026-06-12
 * ======================================================================== */

import DemoLayout from '../layouts/DemoLayout.astro';
---

<DemoLayout title="Pharos Kitchen Design - Concept Demo">
	<main class="demo-container">
		<!-- Header Zone -->
		<header class="blueprint-border conceptual-header">
			<div class="dot-label">
				<span class="baldessari-dot dot-green"></span>
				<div class="dot-text">
					<h1>Pharos Kitchen Design</h1>
					<p class="desc-text">At the top of the page are links for the blog and login/settings, accompanied by a user profile icon.</p>
				</div>
			</div>
			
			<div class="mock-nav">
				<span class="mock-link">Blog</span>
				<span class="mock-link">Login & Settings</span>
				<div class="mock-profile-icon">
					<!-- SVG Person Icon -->
					<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
						<path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
					</svg>
				</div>
			</div>
		</header>

		<!-- OmniBar Zone -->
		<section class="blueprint-border conceptual-omnibar">
			<div class="dot-label">
				<span class="baldessari-dot dot-yellow"></span>
				<div class="dot-text">
					<span class="zone-title">The OmniBar</span>
					<p class="desc-text">Below the header is the OmniBar, where you will type search criteria such as a manufacturer name, a product name, or an equipment category.</p>
				</div>
			</div>
			<div class="mock-input">
				<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" class="search-icon">
					<circle cx="11" cy="11" r="8"></circle>
					<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
				</svg>
				<span class="mock-placeholder">Search Hobart, Vulcan, reach-in, etc...</span>
			</div>
		</section>

		<!-- Main Workspace Columns -->
		<div class="workspace-layout">
			<!-- Canvas Stage Zone -->
			<section class="blueprint-border conceptual-stage">
				<div class="dot-label">
					<span class="baldessari-dot dot-blue"></span>
					<div class="dot-text">
						<span class="zone-title">WebGL Canvas Stage</span>
						<p class="desc-text">The center of the page is the canvas stage, where we will render a lightweight 3D preview model of your selected product.</p>
					</div>
				</div>
				<div class="mock-canvas-indicator">
					<svg viewBox="0 0 100 100" class="wireframe-cube">
						<polygon points="50,15 85,35 85,75 50,95 15,75 15,35" fill="none" stroke="currentColor" stroke-dasharray="4 4"/>
						<line x1="50" y1="15" x2="50" y2="95" stroke="currentColor" stroke-dasharray="4 4"/>
						<line x1="15" y1="35" x2="50" y2="55" stroke="currentColor" stroke-dasharray="4 4"/>
						<line x1="85" y1="35" x2="50" y2="55" stroke="currentColor" stroke-dasharray="4 4"/>
					</svg>
					<span class="mock-badge">Lightweight 3D Mesh Staging Area</span>
				</div>
			</section>

			<!-- Inspector Panel Zone -->
			<section class="blueprint-border conceptual-inspector">
				<div class="dot-label">
					<span class="baldessari-dot dot-red"></span>
					<div class="dot-text">
						<span class="zone-title">Inspector Panel</span>
						<p class="desc-text">To the right is the inspector panel, where we will display the metadata of the selected product—including its name, manufacturer, physical dimensions, and links to official specification documents.</p>
					</div>
				</div>
				<div class="mock-metadata-stack">
					<div class="metadata-line header-line"></div>
					<div class="metadata-line"></div>
					<div class="metadata-line"></div>
					<div class="metadata-line short-line"></div>
				</div>
			</section>
		</div>

		<!-- John Baldessari Repetition Statement -->
		<footer class="conceptual-statement">
			<p class="baldessari-text statement-1">I WILL NOT BUILD ANY MORE BLOATED BIM FILES.</p>
			<p class="baldessari-text statement-2">I WILL NOT BUILD ANY MORE BLOATED BIM FILES.</p>
			<p class="baldessari-text statement-3">I WILL NOT BUILD ANY MORE BLOATED BIM FILES.</p>
		</footer>
	</main>
</DemoLayout>

<style>
	.demo-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 2rem 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 2rem;
		min-height: 90vh;
		justify-content: space-between;
	}

	/* Layout & Spacing */
	.conceptual-header {
		padding: 1.5rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 1.5rem;
	}

	.conceptual-omnibar {
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.workspace-layout {
		display: grid;
		grid-template-columns: 2fr 1fr;
		gap: 2rem;
	}

	@media (max-width: 768px) {
		.workspace-layout {
			grid-template-columns: 1fr;
		}
	}

	.conceptual-stage {
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		min-height: 350px;
	}

	.conceptual-inspector {
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		min-height: 350px;
	}

	/* John Baldessari Dots */
	.dot-label {
		display: flex;
		align-items: flex-start;
		gap: 1rem;
	}

	.baldessari-dot {
		width: 28px;
		height: 28px;
		border-radius: 50%;
		display: inline-block;
		flex-shrink: 0;
		box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
	}

	.dot-green { background-color: #10b981; }
	.dot-yellow { background-color: #fbbf24; }
	.dot-blue { background-color: #3b82f6; }
	.dot-red { background-color: #ef4444; }

	.dot-text {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.dot-text h1 {
		font-size: 1.5rem;
		margin: 0;
		line-height: 1.2;
		font-weight: 800;
		letter-spacing: -0.025em;
	}

	.zone-title {
		font-size: 1.25rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.desc-text {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.5;
		color: rgb(var(--text-muted));
	}

	/* Mock UI Visuals */
	.mock-nav {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}

	.mock-link {
		font-size: 0.9rem;
		font-weight: 600;
		opacity: 0.8;
		border-bottom: 1px dashed currentColor;
		cursor: default;
	}

	.mock-profile-icon {
		width: 36px;
		height: 36px;
		border-radius: 50%;
		border: 1px solid rgba(var(--border-blueprint), var(--border-opacity));
		display: flex;
		align-items: center;
		justify-content: center;
		opacity: 0.8;
	}

	.mock-input {
		border: 1px solid rgba(var(--border-blueprint), var(--border-opacity));
		background-color: rgba(var(--text-base), 0.02);
		padding: 0.75rem 1rem;
		display: flex;
		align-items: center;
		gap: 0.75rem;
		color: rgb(var(--text-muted));
	}

	.mock-placeholder {
		font-family: monospace;
		font-size: 0.9rem;
	}

	.mock-canvas-indicator {
		flex-grow: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 1.5rem;
		opacity: 0.35;
		padding: 2rem 0;
	}

	.wireframe-cube {
		width: 100px;
		height: 100px;
		animation: rotateCube 15s linear infinite;
	}

	@keyframes rotateCube {
		from { transform: rotate(0deg); }
		to { transform: rotate(360deg); }
	}

	.mock-badge {
		font-family: monospace;
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
	}

	.mock-metadata-stack {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 1.5rem 0;
		opacity: 0.25;
	}

	.metadata-line {
		height: 12px;
		background-color: currentColor;
		border-radius: 2px;
		width: 100%;
	}

	.header-line {
		height: 20px;
		width: 60%;
		margin-bottom: 0.5rem;
	}

	.short-line {
		width: 40%;
	}

	/* John Baldessari Repetition Statement */
	.conceptual-statement {
		margin-top: 3rem;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
	}

	.baldessari-text {
		font-family: 'Courier New', Courier, monospace;
		font-weight: 700;
		font-size: 1.4rem;
		margin: 0;
		letter-spacing: 0.05em;
		text-align: center;
	}

	@media (max-width: 600px) {
		.baldessari-text {
			font-size: 0.9rem;
		}
	}

	.statement-1 {
		opacity: 0.9;
	}

	.statement-2 {
		opacity: 0.55;
	}

	.statement-3 {
		opacity: 0.25;
	}
</style>
